    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-S4FMXQ0BLL');
    </script>

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <meta name="description"
        content="Contact Matthew Thompson for private tuition in Southampton, Winchester and Romsey." />

    <title><%= title %></title>

    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#07111f">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
        rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Font Awesome -->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
        crossorigin="anonymous"></script>

    <style>

        :root {
            --bg: #07111f;
            --card: rgba(255,255,255,0.06);
            --text: #f5f7fb;
            --muted: #b8c2d0;
            --primary: #60a5fa;
            --secondary: #8b5cf6;
            --border: rgba(255,255,255,0.1);
            --correct: #34d399;
            --wrong: #f87171;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--bg);
            color: var(--text);
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }

        /* Background Blurs */

        .bg-blur {
            position: fixed;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.22;
            z-index: -1;
            animation: float 12s ease-in-out infinite;
        }

        .bg-one {
            background: #2563eb;
            top: -200px;
            left: -200px;
        }

        .bg-two {
            background: #7c3aed;
            bottom: -250px;
            right: -200px;
            animation-delay: 4s;
        }

        @keyframes float {

            0%,100% {
                transform: translateY(0px) translateX(0px);
            }

            50% {
                transform: translateY(40px) translateX(30px);
            }

        }

        /* Navbar */

        .navbar {
            background: rgba(7, 17, 31, 0.72);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            padding: 18px 0;
        }

        .navbar-brand {
            color: white !important;
            font-weight: 700;
            font-size: 1.3rem;
        }

        .nav-link {
            color: rgba(255,255,255,0.78) !important;
            margin-left: 18px;
            transition: 0.3s ease;
            font-weight: 500;
        }

        .nav-link:hover {
            color: white !important;
            transform: translateY(-2px);
        }

        .user-badge {
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            padding: 10px 18px;
            border-radius: 100px;
            color: white;
            font-weight: 600;
            font-size: 0.9rem;
        }

        /* Hero */

        .hero {
            min-height: 55vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding-top: 80px;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.08);
            padding: 10px 18px;
            border-radius: 100px;
            margin-bottom: 30px;
            animation: fadeUp 1s ease;
        }

        .hero-badge i {
            color: #60a5fa;
        }

        .hero h1 {
            font-size: 4.6rem;
            line-height: 1.05;
            font-family: 'Playfair Display', serif;
            margin-bottom: 25px;
            animation: fadeUp 1.1s ease;
        }

        .hero p {
            color: var(--muted);
            font-size: 1.15rem;
            line-height: 1.8;
            max-width: 700px;
            animation: fadeUp 1.2s ease;
        }

        /* Glass */

        .glass-card {
            background: var(--card);
            border: 1px solid var(--border);
            backdrop-filter: blur(18px);
            border-radius: 28px;
            transition: 0.4s ease;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        }

        .glass-card:hover {
            transform: translateY(-8px);
            border-color: rgba(255,255,255,0.18);
        }

        /* Buttons */

        .btn-main {
            background: linear-gradient(135deg, #2563eb, #8b5cf6);
            border: none;
            color: white;
            padding: 16px 28px;
            border-radius: 16px;
            font-weight: 600;
            transition: 0.35s ease;
            width: 100%;
            box-shadow: 0 10px 35px rgba(59,130,246,0.3);
        }

        .btn-main:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 45px rgba(59,130,246,0.45);
            color: white;
        }

        .btn-main:disabled {
            opacity: 0.4;
            pointer-events: none;
        }

        .btn-ghost {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            color: white;
            padding: 16px 28px;
            border-radius: 16px;
            font-weight: 600;
            transition: 0.35s ease;
            width: 100%;
        }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.12);
            transform: translateY(-4px);
            color: white;
        }

        /* Quiz Section */

        .quiz-section {
            padding: 40px 0 120px;
            min-height: 50vh;
        }

        .view {
            display: none;
        }

        .view.active {
            display: block;
            animation: fadeUp 0.6s ease;
        }

        /* Quiz menu cards */

        .quiz-card {
            padding: 34px 28px;
            height: 100%;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            text-align: left;
            color: var(--text);
        }

        .quiz-card .quiz-icon {
            width: 58px;
            height: 58px;
            border-radius: 18px;
            background: rgba(255,255,255,0.06);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: #60a5fa;
            margin-bottom: 22px;
        }

        .quiz-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            margin-bottom: 10px;
        }

        .quiz-card p {
            color: var(--muted);
            line-height: 1.7;
            font-size: 0.97rem;
            flex-grow: 1;
        }

        .quiz-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid var(--border);
            font-size: 0.9rem;
            color: var(--muted);
        }

        .best-score {
            color: var(--primary);
            font-weight: 600;
        }

        .resume-pill {
            display: inline-block;
            background: rgba(139,92,246,0.2);
            border: 1px solid rgba(139,92,246,0.4);
            color: #c4b5fd;
            border-radius: 100px;
            padding: 3px 12px;
            font-size: 0.78rem;
            margin-bottom: 12px;
            align-self: flex-start;
        }

        /* Quiz play */

        .quiz-panel {
            padding: 50px;
            max-width: 820px;
            margin: 0 auto;
        }

        .quiz-panel:hover,
        .quiz-panel.glass-card:hover {
            transform: none;
        }

        .quiz-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            color: var(--muted);
            font-size: 0.95rem;
        }

        .quiz-top .quiz-name {
            color: white;
            font-weight: 600;
        }

        .progress-track {
            height: 8px;
            border-radius: 100px;
            background: rgba(255,255,255,0.08);
            overflow: hidden;
            margin-bottom: 35px;
        }

        .progress-fill {
            height: 100%;
            width: 0%;
            border-radius: 100px;
            background: linear-gradient(135deg, #2563eb, #8b5cf6);
            transition: width 0.5s ease;
        }

        .question-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.9rem;
            line-height: 1.35;
            margin-bottom: 30px;
        }

        .option-btn {
            display: flex;
            align-items: center;
            gap: 16px;
            width: 100%;
            text-align: left;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            color: white;
            border-radius: 18px;
            padding: 16px 20px;
            margin-bottom: 14px;
            font-size: 1.02rem;
            transition: 0.3s ease;
        }

        .option-btn:hover:not(:disabled) {
            background: rgba(255,255,255,0.09);
            border-color: #60a5fa;
            transform: translateX(6px);
        }

        .option-btn:disabled {
            cursor: default;
        }

        .option-letter {
            flex-shrink: 0;
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .option-btn.correct {
            background: rgba(52,211,153,0.14);
            border-color: var(--correct);
        }

        .option-btn.correct .option-letter {
            background: var(--correct);
            color: #04210f;
        }

        .option-btn.wrong {
            background: rgba(248,113,113,0.14);
            border-color: var(--wrong);
        }

        .option-btn.wrong .option-letter {
            background: var(--wrong);
            color: #2a0707;
        }

        .option-btn.selected {
            background: rgba(96,165,250,0.14);
            border-color: var(--primary);
        }

        .option-btn.selected .option-letter {
            background: var(--primary);
            color: #06182e;
        }

        .option-btn.missed {
            border-style: dashed;
        }

        .multi-hint {
            display: none;
            color: var(--primary);
            font-weight: 500;
            font-size: 0.95rem;
            margin: -14px 0 22px;
        }

        .explanation {
            display: none;
            background: rgba(255,255,255,0.05);
            border-left: 3px solid var(--primary);
            border-radius: 12px;
            padding: 16px 20px;
            margin: 6px 0 24px;
            color: var(--muted);
            line-height: 1.7;
        }

        .explanation.show {
            display: block;
            animation: fadeUp 0.4s ease;
        }

        .quiz-actions {
            display: flex;
            gap: 14px;
            margin-top: 10px;
        }

        .quiz-actions .btn-ghost {
            width: auto;
            flex-shrink: 0;
        }

        /* Results */

        .score-circle {
            width: 190px;
            height: 190px;
            border-radius: 50%;
            margin: 0 auto 28px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(closest-side, #0b1a2e 78%, transparent 80% 100%),
                conic-gradient(var(--primary) calc(var(--pct) * 1%), rgba(255,255,255,0.08) 0);
        }

        .score-circle .score-big {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            line-height: 1;
        }

        .score-circle .score-small {
            color: var(--muted);
            font-size: 0.95rem;
            margin-top: 6px;
        }

        .result-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.4rem;
            margin-bottom: 10px;
            text-align: center;
        }

        .result-text {
            color: var(--muted);
            text-align: center;
            line-height: 1.8;
            margin-bottom: 35px;
        }

        .review-list {
            margin-bottom: 35px;
        }

        .review-item {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 18px;
            padding: 18px 22px;
            margin-bottom: 12px;
        }

        .review-item .review-q {
            font-weight: 600;
            margin-bottom: 8px;
        }

        .review-item .review-a {
            color: var(--muted);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .review-item.is-correct {
            border-left: 3px solid var(--correct);
        }

        .review-item.is-wrong {
            border-left: 3px solid var(--wrong);
        }

        .result-actions {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .result-actions button {
            flex: 1 1 200px;
        }

        .clear-link {
            background: none;
            border: none;
            color: var(--muted);
            font-size: 0.9rem;
            text-decoration: underline;
            margin-top: 30px;
        }

        .clear-link:hover {
            color: white;
        }

        /* Footer */

        footer {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 45px 0;
            text-align: center;
            color: rgba(255,255,255,0.6);
        }

        .socials {
            margin-bottom: 20px;
        }

        .socials a {
            width: 50px;
            height: 50px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin: 0 8px;
            background: rgba(255,255,255,0.06);
            color: white;
            transition: 0.35s ease;
        }

        .socials a:hover {
            background: linear-gradient(135deg, #2563eb, #8b5cf6);
            transform: translateY(-5px);
        }

        /* Animations */

        @keyframes fadeUp {

            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        .reveal {
            opacity: 0;
            transform: translateY(60px);
            transition: all 1s ease;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Responsive */

        @media(max-width: 992px) {

            .hero h1 {
                font-size: 3.5rem;
            }

            .quiz-panel {
                padding: 35px;
            }

        }

        @media(max-width: 768px) {

            .hero {
                min-height: 50vh;
                text-align: center;
            }

            .hero h1 {
                font-size: 2.8rem;
            }

            .quiz-panel {
                padding: 30px 22px;
            }

            .question-text {
                font-size: 1.5rem;
            }

            .result-title {
                font-size: 2rem;
            }

        }

    </style>

</head>

<body>

    <!-- Animated Background -->
    <div class="bg-blur bg-one"></div>
    <div class="bg-blur bg-two"></div>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg fixed-top" id="mainNav">

        <div class="container">

            <a class="navbar-brand" href="/">
                Matthew Thompson • Zenith Tutoring
            </a>

            <button class="navbar-toggler text-white"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarResponsive">

                <i class="fas fa-bars"></i>

            </button>

            <div class="collapse navbar-collapse" id="navbarResponsive">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contact">Contact</a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- Hero -->
    <section class="hero">

        <div class="container">

            <div class="row justify-content-center text-center">

                <div class="col-lg-8">

                    <h1>
                        Test your knowledge with a quiz!
                    </h1>

                    <p>
                        Choose a quiz down below in History, English Literature or English Language.
                    </p>

                </div>

            </div>

        </div>

    </section>

    <!-- Quiz Section -->
    <section class="quiz-section" id="quizzes">

        <div class="container">

            <!-- VIEW 1: Quiz selection (cards are generated from QUIZZES below) -->
            <div class="view active" id="menuView">
                <div class="row g-4" id="quizGrid"></div>

                <div class="text-center">
                    <button class="clear-link" id="clearDataBtn" type="button">Clear saved scores and progress</button>
                </div>
            </div>

            <!-- VIEW 2: Question screen -->
            <div class="view" id="quizView">
                <div class="glass-card quiz-panel">

                    <div class="quiz-top">
                        <span class="quiz-name" id="quizName"></span>
                        <span id="quizCounter"></span>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>

                    <h2 class="question-text" id="questionText"></h2>
                    <p class="multi-hint" id="multiHint"></p>

                    <div id="optionsWrap"></div>

                    <div class="explanation" id="explanation"></div>

                    <div class="quiz-actions">
                        <button class="btn-ghost" id="quitBtn" type="button">
                            <i class="fas fa-arrow-left me-2"></i>Quizzes
                        </button>
                        <button class="btn-main" id="nextBtn" type="button" disabled>Next question</button>
                    </div>

                </div>
            </div>

            <!-- VIEW 3: Results -->
            <div class="view" id="resultView">
                <div class="glass-card quiz-panel">

                    <div class="score-circle" id="scoreCircle" style="--pct:0">
                        <span class="score-big" id="scoreBig">0/0</span>
                        <span class="score-small" id="scorePct">0%</span>
                    </div>

                    <h2 class="result-title" id="resultTitle"></h2>
                    <p class="result-text" id="resultText"></p>

                    <div class="review-list" id="reviewList"></div>

                    <div class="result-actions">
                        <button class="btn-main" id="retryBtn" type="button">Try this quiz again</button>
                        <button class="btn-ghost" id="backBtn" type="button">Choose another quiz</button>
                    </div>

                </div>
            </div>

        </div>

    </section>

    <!-- Footer -->
    <footer>

        <div class="container">

            <div class="socials">

                <a href="https://www.facebook.com/profile.php?id=100090036200059">
                    <i class="fab fa-facebook-f"></i>
                </a>

                <a href="#">
                    <i class="fab fa-instagram"></i>
                </a>

                <a href="#">
                    <i class="fab fa-linkedin-in"></i>
                </a>

            </div>

            <p>
                © 2026 Matthew Thompson Zenith Tuition
            </p>

        </div>

    </footer>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scroll Reveal -->
    <script>

        const reveals = document.querySelectorAll(".reveal");

        function revealOnScroll() {

            reveals.forEach((element) => {

                const windowHeight = window.innerHeight;
                const revealTop = element.getBoundingClientRect().top;

                if (revealTop < windowHeight - 100) {

                    element.classList.add("active");

                }

            });

        }

        window.addEventListener("scroll", revealOnScroll);

        revealOnScroll();

    </script>

    <!-- ============================================================
         QUIZ DATA
         ------------------------------------------------------------
         Each quiz needs:
           id          unique, no spaces (used for saving scores)
           title       shown on the card
           description shown on the card
           icon        any Font Awesome icon class
           questions   array of question objects

         Each question needs:
           q            the question text
           options      array of answer strings (any number, 2-6)
           answer       ONE correct option:   answer: 1        (0 = first option)
                        SEVERAL correct:      answer: [0, 2]   (learner must tick all of them)
           explanation  (optional) shown after the learner answers
         ============================================================ -->
    <script>

        const QUIZZES = [

            {
                id: "history-1",
                title: "History: 20th Century",
                description: "Test your knowledge with this 20th century themed quiz!",
                icon: "fas fa-landmark",
                questions: [
                    {
                        q: "In what year did World War One begin?",
                        options: ["1914", "1915", "1916", "1917"],
                        answer: 0,
                        explanation: ""
                    },
                    {
                        q: "Which treaty marked the end of World War 1?",
                        options: ["The Treaty of Brest-Litovsk", "The Treaty of Versailles", "The Treaty of London", "The Locarno Pact"],
                        answer: 1,
                        explanation: ""
                    },
                    {
                        q: "Which U.S President served into his 4th term - from 1933-1945?",
                        options: ["Woodrow Wilson", "Franklin D Roosevelt", "Herbert Hoover", "Harry Truman"],
                        answer: 1,
                        explanation: ""
                    },
                    {
                        q: "Which agreement saw Hitler ally with Stalin before World War 2 began?",
                        options: ["The Non-Intervention Agreement", "The Nazi-Soviet Pact", "The Nuremberg Laws", "The Kellogg-Briand Pact"],
                        answer: 1,
                        explanation: ""
                    },
                    {
                        q: "Who was Hitler’s chief of propaganda?",
                        options: ["Heinrich Himmler", "Rudolf Hess", "Albert Speer", "Joseph Goebbels"],
                        answer: 3,
                        explanation: ""
                    },
                    {
                        q: "What does Blitzkrieg mean?",
                        options: ["Total War", "Lightning war", "War Communism", "People's community"],
                        answer: 1,
                        explanation: ""
                    },
                    {
                        q: "Why did Russia leave World War 1 in 1917?",
                        options: ["Defeat at the Battle of Tannenberg", "Stalin came to power", "A Revolution occurred", "Rasputin was executed"],
                        answer: 2,
                        explanation: ""
                    },
                    {
                        q: "When was the Cuban Missile Crisis?",
                        options: ["1962", "1960", "1964", "1968"],
                        answer: 0,
                        explanation: ""
                    },
                    {
                        q: "Who was the leader of the USSR when it fell in 1991?",
                        options: ["Joseph Stalin", "Nikita Khrushchev", "Leonid Brezhnev", "Mikhail Gorbachev"],
                        answer: 3,
                        explanation: ""
                    },
                    {
                        q: "Which TWO countries never joined the League of Nations?",
                        options: ["United States of America", "Great Britain", "Germany", "France", "Russia", "Japan", "Switzerland", "Italy"],
                        answer: [0, 4],
                        explanation: ""
                    }
                ]
            },

            {
                id: "history-1",
                title: "History: Pre-20th Century",
                description: "Test your knowledge with this Pre-20th century themed quiz!",
                icon: "fas fa-landmark",
                questions: [
                    {
                        q: "Who was the FIRST Tudor Monarch?",
                        options: ["Henry VII", "Henry VIII", "Richard III", "Edward V"],
                        answer: 0,
                        explanation: ""
                    },
                    {
                        q: "What is Mary 1 better known as?",
                        options: ["Mary Queen of Scots", "Bloody Mary", "The Virgin Queen", "Mary of Orange"],
                        answer: 1,
                        explanation: ""
                    },
                    {
