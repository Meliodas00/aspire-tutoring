    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scroll Reveal -->
    <script>

        const reveals = document.querySelectorAll(".reveal");

        function revealOnScroll() {

            reveals.forEach((element) => {

                const windowHeight = window.innerHeight;
                const revealTop = element.getBoundingClientRect().top;

                if (revealTop < windowHeight - 100) {

                    element.classList.add("active");

                }

            });

        }

        window.addEventListener("scroll", revealOnScroll);

        revealOnScroll();

    </script>

    <div id="quizData" data-quizzes="<%= JSON.stringify(quizzes) %>" hidden></div>

    <script>

        const QUIZZES = JSON.parse(document.getElementById("quizData").dataset.quizzes);
        const STORAGE_KEY = "zenithQuiz";

        // Each quiz gets its own accent colour, in order
        const ACCENTS = ["#60a5fa", "#f472b6", "#fbbf24", "#34d399", "#a78bfa", "#fb923c"];

        function accentFor(quiz) {
            const i = QUIZZES.findIndex(q => q.id === quiz.id);
            return ACCENTS[(i < 0 ? 0 : i) % ACCENTS.length];
        }

        const GOOD_TITLES = ["Correct!", "Spot on!", "Nailed it!", "Well done!"];
        const BAD_TITLES = ["Not quite", "So close", "Good try"];

        function pick(list) {
            return list[Math.floor(Math.random() * list.length)];
        }

        // ---------- Storage ----------

        function loadData() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                const data = raw ? JSON.parse(raw) : {};
                return { scores: data.scores || {}, progress: data.progress || {} };
            } catch (e) {
                return { scores: {}, progress: {} };
            }
        }

        function saveData() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(store));
            } catch (e) {
                console.log("Could not save quiz data", e);
            }
        }

        let store = loadData();

        // ---------- State ----------

        let currentQuiz = null;
        let currentIndex = 0;
        let userAnswers = [];     // chosen option index per question (null = unanswered)
        let answered = false;

        // ---------- Elements ----------

        const $ = (id) => document.getElementById(id);

        const views = {
            menu: $("menuView"),
            quiz: $("quizView"),
            result: $("resultView")
        };

        function showView(name) {
            Object.values(views).forEach(v => v.classList.remove("active"));
            views[name].classList.add("active");
            window.scrollTo({ top: $("quizzes").offsetTop - 90, behavior: "smooth" });
        }

        // ---------- Confetti ----------

        function confettiBurst() {

            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

            const colours = ["#60a5fa", "#f472b6", "#fbbf24", "#34d399", "#a78bfa", "#fb923c"];

            for (let i = 0; i < 60; i++) {

                const bit = document.createElement("span");
                bit.className = "confetti";
                bit.style.left = Math.random() * 100 + "vw";
                bit.style.background = colours[i % colours.length];
                bit.style.setProperty("--x", (Math.random() * 200 - 100) + "px");
                bit.style.setProperty("--r", (Math.random() * 720 - 360) + "deg");
                bit.style.animationDelay = (Math.random() * 0.6) + "s";
                bit.style.animationDuration = (2.2 + Math.random() * 1.6) + "s";

                document.body.appendChild(bit);
                setTimeout(() => bit.remove(), 5000);

            }

        }

        // ---------- Menu ----------

        function renderMenu() {

            const grid = $("quizGrid");
            grid.innerHTML = "";

            QUIZZES.forEach(quiz => {

                const total = quiz.questions.length;
                const score = store.scores[quiz.id];
                const progress = store.progress[quiz.id];
                const inProgress = progress && progress.index > 0 && progress.index < total;

                const col = document.createElement("div");
                col.className = "col-md-6 col-lg-4";

                const card = document.createElement("div");
                card.className = "glass-card quiz-card";
                card.style.setProperty("--accent", accentFor(quiz));
                card.tabIndex = 0;
                card.setAttribute("role", "button");

                if (inProgress) {
                    const pill = document.createElement("span");
                    pill.className = "resume-pill";
                    pill.textContent = "In progress: question " + (progress.index + 1) + " of " + total;
                    card.appendChild(pill);
                }

                const icon = document.createElement("div");
                icon.className = "quiz-icon";
                icon.innerHTML = '<i class="' + quiz.icon + '"></i>';

                const title = document.createElement("h3");
                title.textContent = quiz.title;

                const desc = document.createElement("p");
                desc.textContent = quiz.description;

                const meta = document.createElement("div");
                meta.className = "quiz-meta";

                const count = document.createElement("span");
                count.textContent = total + (total === 1 ? " question" : " questions");

                const best = document.createElement("span");
                best.className = "best-score";
                best.textContent = score ? "Best: " + score.best + "/" + score.total : "Not tried yet";

                meta.appendChild(count);
                meta.appendChild(best);

                const cta = document.createElement("span");
                cta.className = "start-cta";
                cta.innerHTML = (inProgress ? "Continue quiz" : score ? "Play again" : "Start quiz") +
                    ' <i class="fas fa-arrow-right"></i>';

                card.appendChild(icon);
                card.appendChild(title);
                card.appendChild(desc);
                card.appendChild(meta);
                card.appendChild(cta);

                const start = () => startQuiz(quiz.id);
                card.addEventListener("click", start);
                card.addEventListener("keydown", e => {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        start();
                    }
                });

                col.appendChild(card);
                grid.appendChild(col);

            });

        }

        // ---------- Quiz flow ----------

        function startQuiz(id, forceRestart) {

            currentQuiz = QUIZZES.find(q => q.id === id);
            if (!currentQuiz) return;

            const saved = store.progress[id];
            const total = currentQuiz.questions.length;

            if (!forceRestart && saved && saved.index < total && saved.answers.length === total) {
                // Resume where they left off
                currentIndex = saved.index;
                userAnswers = saved.answers;
            } else {
                currentIndex = 0;
                userAnswers = new Array(total).fill(null);
                delete store.progress[id];
                saveData();
            }

            const accent = accentFor(currentQuiz);
            views.quiz.style.setProperty("--accent", accent);
            views.result.style.setProperty("--accent", accent);

            $("quizName").textContent = currentQuiz.title;
            showView("quiz");
            renderQuestion();

        }

        // ---------- Feedback panel (under the options) ----------

        function showFeedback(question, right, correct) {

            const panel = $("feedbackPanel");
            panel.classList.remove("good", "bad");
            panel.classList.add(right ? "good" : "bad");

            $("fbIcon").innerHTML = '<i class="fas ' + (right ? "fa-check" : "fa-lightbulb") + '"></i>';
            $("fbTitle").textContent = right ? pick(GOOD_TITLES) : pick(BAD_TITLES);

            const ans = $("fbAnswer");
            if (right) {
                ans.style.display = "none";
            } else {
                ans.style.display = "block";
                ans.textContent = "The correct answer" + (correct.length > 1 ? "s are: " : " is: ") +
                    describeAnswer(question, correct);
            }

            const fact = (question.explanation || "").trim();
            $("fbFact").style.display = fact ? "block" : "none";
            $("fbFactText").textContent = fact;

            panel.classList.add("show");

            // Make sure it's visible on small screens
            if (panel.scrollIntoView) panel.scrollIntoView({ behavior: "smooth", block: "nearest" });

        }

        function closeFeedback() {
            $("feedbackPanel").classList.remove("show");
        }

        // ---------- Question helpers ----------

        let pending = [];   // options ticked on a multi-select question before it is checked

        function isMulti(q) {
            return Array.isArray(q.answer);
        }

        function correctList(q) {
            return isMulti(q) ? q.answer : [q.answer];
        }

        function isCorrect(q, ans) {
            if (ans === null || ans === undefined) return false;
            if (isMulti(q)) {
                if (!Array.isArray(ans)) return false;
                const a = ans.slice().sort((x, y) => x - y).join(",");
                const b = q.answer.slice().sort((x, y) => x - y).join(",");
                return a === b;   // all-or-nothing: must match exactly
            }
            return ans === q.answer;
        }

        function describeAnswer(q, ans) {
            if (ans === null || ans === undefined || (Array.isArray(ans) && !ans.length)) return "No answer";
            const list = Array.isArray(ans) ? ans : [ans];
            return list.slice().sort((x, y) => x - y).map(i => q.options[i]).join(", ");
        }

        function setNextLabel() {
            const last = currentIndex === currentQuiz.questions.length - 1;
            $("nextBtn").textContent = last ? "See my score" : "Next question";
        }

        function renderQuestion() {

            const quiz = currentQuiz;
            const total = quiz.questions.length;
            const question = quiz.questions[currentIndex];
            const multi = isMulti(question);

            answered = false;
            pending = [];

            $("quizCounter").textContent = "Question " + (currentIndex + 1) + " of " + total;
            $("progressFill").style.width = ((currentIndex) / total * 100) + "%";
            $("questionText").textContent = question.q;

            const hint = $("multiHint");
            hint.style.display = multi ? "block" : "none";
            hint.textContent = "Select all that apply";

            closeFeedback();

            const next = $("nextBtn");
            next.disabled = true;
            if (multi) next.textContent = "Check answer";
            else setNextLabel();

            const wrap = $("optionsWrap");
            wrap.innerHTML = "";

            question.options.forEach((text, i) => {

                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "option-btn";

                const letter = document.createElement("span");
                letter.className = "option-letter";
                letter.textContent = String.fromCharCode(65 + i);

                const label = document.createElement("span");
                label.textContent = text;

                btn.appendChild(letter);
                btn.appendChild(label);
                btn.addEventListener("click", () => chooseOption(i));

                wrap.appendChild(btn);

            });

        }

        function chooseOption(i) {

            if (answered) return;

            const question = currentQuiz.questions[currentIndex];

            if (isMulti(question)) {

                // Toggle this option on/off
                const pos = pending.indexOf(i);
                if (pos === -1) pending.push(i);
                else pending.splice(pos, 1);

                $("optionsWrap").querySelectorAll(".option-btn").forEach((btn, idx) => {
                    const on = pending.includes(idx);
                    btn.classList.toggle("selected", on);
                    btn.setAttribute("aria-pressed", on);
                });

                $("nextBtn").disabled = pending.length === 0;

            } else {
                submitAnswer(i);
            }

        }

        function submitAnswer(choice) {

            if (answered) return;
            answered = true;

            const question = currentQuiz.questions[currentIndex];
            const multi = isMulti(question);
            userAnswers[currentIndex] = choice;

            const chosen = Array.isArray(choice) ? choice : [choice];
            const correct = correctList(question);

            $("optionsWrap").querySelectorAll(".option-btn").forEach((btn, i) => {

                btn.disabled = true;
                btn.classList.remove("selected");

                const isRight = correct.includes(i);
                const picked = chosen.includes(i);

                if (isRight && picked) btn.classList.add("correct");
                else if (isRight) btn.classList.add("correct", multi ? "missed" : "correct");
                else if (picked) btn.classList.add("wrong");

            });

            // Show the friendly feedback + the fact under the options
            showFeedback(question, isCorrect(question, choice), correct);

            setNextLabel();
            $("nextBtn").disabled = false;

            // Save progress (points to the NEXT question so a refresh resumes there)
            store.progress[currentQuiz.id] = {
                index: currentIndex + 1,
                answers: userAnswers
            };
            saveData();

        }

        function nextQuestion() {

            closeFeedback();

            const total = currentQuiz.questions.length;

            if (currentIndex < total - 1) {
                currentIndex++;
                renderQuestion();
            } else {
                finishQuiz();
            }

        }

        // ---------- Results ----------

        function finishQuiz() {

            const quiz = currentQuiz;
            const total = quiz.questions.length;

            let score = 0;
            quiz.questions.forEach((q, i) => {
                if (isCorrect(q, userAnswers[i])) score++;
            });

            const pct = total ? Math.round((score / total) * 100) : 0;

            // Save score, clear unfinished progress
            const previous = store.scores[quiz.id];
            const isNewBest = previous && score > previous.best;
            store.scores[quiz.id] = {
                best: previous ? Math.max(previous.best, score) : score,
                last: score,
                total: total,
                date: new Date().toISOString()
            };
            delete store.progress[quiz.id];
            saveData();

            // Fill in the result screen
            $("scoreBig").textContent = score + "/" + total;
            $("scorePct").textContent = pct + "%";
            $("scoreCircle").style.setProperty("--pct", pct);

            let title, text;
            if (pct === 100)      { title = "Perfect score! \uD83C\uDF89";  text = "Every answer correct. Brilliant work!"; }
            else if (pct >= 70)   { title = "Great job! \uD83D\uDC4F";      text = "A strong result. Check the review below to tidy up the last few gaps."; }
            else if (pct >= 40)   { title = "Good effort! \uD83D\uDCAA";    text = "You're getting there. Look through the review below and have another go."; }
            else                  { title = "Every try counts \uD83C\uDF31"; text = "That's how learning works. Read through the answers below, then try again and see how far you climb."; }

            $("resultTitle").textContent = title;
            $("resultText").textContent = text +
                (isNewBest ? " That's a new personal best!" : "") +
                " Your best for this quiz is " + store.scores[quiz.id].best + "/" + total + ".";

            // Review list
            const list = $("reviewList");
            list.innerHTML = "";

            quiz.questions.forEach((q, i) => {

                const correct = isCorrect(q, userAnswers[i]);

                const item = document.createElement("div");
                item.className = "review-item " + (correct ? "is-correct" : "is-wrong");

                const qEl = document.createElement("div");
                qEl.className = "review-q";
                qEl.textContent = (i + 1) + ". " + q.q;

                const aEl = document.createElement("div");
                aEl.className = "review-a";

                const yours = describeAnswer(q, userAnswers[i]);

                aEl.textContent = correct
                    ? "Your answer: " + yours + " (correct)"
                    : "Your answer: " + yours + ". Correct answer: " + describeAnswer(q, correctList(q));

                item.appendChild(qEl);
                item.appendChild(aEl);
                list.appendChild(item);

            });

            $("progressFill").style.width = "100%";
            showView("result");

            if (pct >= 70) confettiBurst();

        }

        // ---------- Buttons ----------

        $("nextBtn").addEventListener("click", () => {
            const q = currentQuiz.questions[currentIndex];
            if (isMulti(q) && !answered) submitAnswer(pending.slice());
            else nextQuestion();
        });

        $("quitBtn").addEventListener("click", () => {
            closeFeedback();
            // Progress is already saved after each answer, so they can resume later
            renderMenu();
            showView("menu");
        });

        $("retryBtn").addEventListener("click", () => startQuiz(currentQuiz.id, true));

        $("backBtn").addEventListener("click", () => {
            renderMenu();
            showView("menu");
        });

        $("clearDataBtn").addEventListener("click", () => {
            if (confirm("Clear all saved scores and progress on this device?")) {
                store = { scores: {}, progress: {} };
                saveData();
                renderMenu();
            }
        });

        // ---------- Init ----------

        renderMenu();

    </script>

    <!-- Service Worker -->
    <script>

        if ("serviceWorker" in navigator) {

            window.addEventListener("load", () => {

                navigator.serviceWorker.register("/service-worker.js")
                .then(reg => {

                    console.log("Service Worker Registered", reg);

                })
                .catch(err => {

                    console.log("Service Worker Failed", err);

                });

            });

        }

    </script>

