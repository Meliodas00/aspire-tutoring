    <!-- Quiz Section -->
    <section class="quiz-section" id="quizzes">

        <div class="container">

            <!-- VIEW 1: Quiz selection (cards are generated from QUIZZES below) -->
            <div class="view active" id="menuView">
                <div class="row g-4" id="quizGrid"></div>

                <div class="text-center">
                    <button class="clear-link" id="clearDataBtn" type="button">Clear saved scores and progress</button>
                </div>
            </div>

            <!-- VIEW 2: Question screen -->
            <div class="view" id="quizView">
                <div class="glass-card quiz-panel">

                    <div class="quiz-top">
                        <span class="quiz-name" id="quizName"></span>
                        <span id="quizCounter"></span>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>

                    <h2 class="question-text" id="questionText"></h2>
                    <p class="multi-hint" id="multiHint"></p>

                    <div id="optionsWrap"></div>

                    <div class="feedback-panel" id="feedbackPanel" aria-live="polite">
                        <div class="fb-head">
                            <span class="fb-icon" id="fbIcon"></span>
                            <span class="fb-title" id="fbTitle"></span>
                        </div>
                        <p class="fb-answer" id="fbAnswer"></p>
                        <div class="fb-fact" id="fbFact">
                            <span class="fb-fact-label">Did you know?</span>
                            <span id="fbFactText"></span>
                        </div>
                    </div>

                    <div class="quiz-actions">
                        <button class="btn-ghost" id="quitBtn" type="button">
                            <i class="fas fa-arrow-left me-2"></i>Quizzes
                        </button>
                        <button class="btn-main" id="nextBtn" type="button" disabled>Next question</button>
                    </div>

                </div>
            </div>

            <!-- VIEW 3: Results -->
            <div class="view" id="resultView">
                <div class="glass-card quiz-panel">

                    <div class="score-circle" id="scoreCircle" style="--pct:0">
                        <span class="score-big" id="scoreBig">0/0</span>
                        <span class="score-small" id="scorePct">0%</span>
                    </div>

                    <h2 class="result-title" id="resultTitle"></h2>
                    <p class="result-text" id="resultText"></p>

                    <div class="review-list" id="reviewList"></div>

                    <div class="result-actions">
                        <button class="btn-main" id="retryBtn" type="button">Try this quiz again</button>
                        <button class="btn-ghost" id="backBtn" type="button">Choose another quiz</button>
                    </div>

                </div>
            </div>

        </div>

    </section>

