<!DOCTYPE html>
<html lang="en">
<head>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S4FMXQ0BLL"></script>

    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-S4FMXQ0BLL');
    </script>

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <meta name="description"
        content="Contact Matthew Thompson for private tuition in Southampton, Winchester and Romsey." />

    <title><%= title %></title>

    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#07111f">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
        rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Font Awesome -->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js"
        crossorigin="anonymous"></script>

    <style>

        :root {
            --bg: #0a1426;
            --card: rgba(255,255,255,0.08);
            --text: #f5f7fb;
            --muted: #c3cddc;
            --primary: #60a5fa;
            --secondary: #8b5cf6;
            --border: rgba(255,255,255,0.14);
            --correct: #34d399;
            --wrong: #fb923c;
            --accent: #60a5fa;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--bg);
            color: var(--text);
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }

        :focus-visible {
            outline: 3px solid #fbbf24;
            outline-offset: 3px;
        }

        /* Background Blurs */

        .bg-blur {
            position: fixed;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.32;
            z-index: -1;
            animation: float 12s ease-in-out infinite;
        }

        .bg-one {
            background: #2563eb;
            top: -200px;
            left: -200px;
        }

        .bg-two {
            background: #7c3aed;
            bottom: -250px;
            right: -200px;
            animation-delay: 4s;
        }

        .bg-three {
            background: #ec4899;
            width: 420px;
            height: 420px;
            opacity: 0.2;
            top: 35%;
            right: -120px;
            animation-delay: 8s;
        }

        .bg-four {
            background: #14b8a6;
            width: 420px;
            height: 420px;
            opacity: 0.2;
            bottom: 5%;
            left: -140px;
            animation-delay: 2s;
        }

        @keyframes float {

            0%,100% {
                transform: translateY(0px) translateX(0px);
            }

            50% {
                transform: translateY(40px) translateX(30px);
            }

        }

        /* Navbar */

        .navbar {
            background: rgba(10, 20, 38, 0.78);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding: 18px 0;
        }

        .navbar-brand {
            color: white !important;
            font-weight: 700;
            font-size: 1.3rem;
        }

        .nav-link {
            color: rgba(255,255,255,0.85) !important;
            margin-left: 18px;
            transition: 0.3s ease;
            font-weight: 500;
        }

        .nav-link:hover {
            color: white !important;
            transform: translateY(-2px);
        }

        .user-badge {
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            padding: 10px 18px;
            border-radius: 100px;
            color: white;
            font-weight: 600;
            font-size: 0.9rem;
        }

        /* Hero */

        .hero {
            min-height: 55vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding-top: 80px;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(251,191,36,0.14);
            border: 1px solid rgba(251,191,36,0.4);
            color: #fde68a;
            padding: 10px 18px;
            border-radius: 100px;
            margin-bottom: 26px;
            font-weight: 500;
            animation: fadeUp 1s ease;
        }

        .hero-badge i {
            color: #fbbf24;
        }

        .hero h1 {
            font-size: 4.6rem;
            line-height: 1.05;
            font-family: 'Playfair Display', serif;
            margin-bottom: 25px;
            animation: fadeUp 1.1s ease;
        }

        .hero h1 span {
            background: linear-gradient(135deg, #60a5fa, #c084fc 55%, #f472b6);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            color: var(--muted);
            font-size: 1.2rem;
            line-height: 1.8;
            max-width: 700px;
            margin: 0 auto;
            animation: fadeUp 1.2s ease;
        }

        .hero-chips {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            margin-top: 30px;
            animation: fadeUp 1.3s ease;
        }

        .hero-chips span {
            background: rgba(255,255,255,0.08);
            border: 1px solid var(--border);
            border-radius: 100px;
            padding: 8px 18px;
            font-size: 0.95rem;
            font-weight: 500;
        }

        .hero-chips i {
            margin-right: 8px;
        }

        .hero-chips span:nth-child(1) i { color: #34d399; }
        .hero-chips span:nth-child(2) i { color: #fbbf24; }
        .hero-chips span:nth-child(3) i { color: #f472b6; }

        /* Floating decorations */

        .float-glyph {
            position: absolute;
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            opacity: 0.16;
            pointer-events: none;
            user-select: none;
            animation: drift 9s ease-in-out infinite;
        }

        @keyframes drift {

            0%,100% {
                transform: translateY(0) rotate(-8deg);
            }

            50% {
                transform: translateY(-26px) rotate(8deg);
            }

        }

        /* Glass */

        .glass-card {
            background: var(--card);
            border: 1px solid var(--border);
            backdrop-filter: blur(18px);
            border-radius: 28px;
            transition: 0.4s ease;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        }

        .glass-card:hover {
            transform: translateY(-8px);
            border-color: rgba(255,255,255,0.28);
        }

        /* Buttons */

        .btn-main {
            background: linear-gradient(135deg, #2563eb, #8b5cf6);
            border: none;
            color: white;
            padding: 16px 28px;
            border-radius: 16px;
            font-weight: 600;
            transition: 0.35s ease;
            width: 100%;
            box-shadow: 0 10px 35px rgba(59,130,246,0.3);
        }

        .btn-main:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 45px rgba(59,130,246,0.45);
            color: white;
        }

        .btn-main:disabled {
            opacity: 0.4;
            pointer-events: none;
        }

        .btn-ghost {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.16);
            color: white;
            padding: 16px 28px;
            border-radius: 16px;
            font-weight: 600;
            transition: 0.35s ease;
            width: 100%;
        }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.14);
            transform: translateY(-4px);
            color: white;
        }

        /* Quiz Section */

        .quiz-section {
            padding: 40px 0 120px;
            min-height: 50vh;
        }

        .view {
            display: none;
        }

        .view.active {
            display: block;
            animation: fadeUp 0.6s ease;
        }

        /* Quiz menu cards (each gets its own accent colour) */

        .quiz-card {
            padding: 34px 28px;
            height: 100%;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            text-align: left;
            color: var(--text);
            position: relative;
            overflow: hidden;
        }

        .quiz-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: var(--accent);
        }

        .quiz-card::after {
            content: "";
            position: absolute;
            top: -60px;
            right: -60px;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: var(--accent);
            opacity: 0.14;
            filter: blur(30px);
            transition: opacity 0.4s ease;
        }

        .quiz-card:hover {
            border-color: var(--accent);
            box-shadow: 0 25px 60px rgba(0,0,0,0.3);
        }

        .quiz-card:hover::after {
            opacity: 0.32;
        }

        .quiz-card .quiz-icon {
            width: 64px;
            height: 64px;
            border-radius: 20px;
            background: rgba(255,255,255,0.1);
            background: color-mix(in srgb, var(--accent) 22%, transparent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: var(--accent);
            margin-bottom: 22px;
            transition: transform 0.4s ease;
        }

        .quiz-card:hover .quiz-icon {
            transform: rotate(-8deg) scale(1.08);
        }

        .quiz-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            margin-bottom: 10px;
        }

        .quiz-card p {
            color: var(--muted);
            line-height: 1.7;
            font-size: 1rem;
            flex-grow: 1;
        }

        .quiz-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid var(--border);
            font-size: 0.92rem;
            color: var(--muted);
        }

        .best-score {
            color: var(--accent);
            font-weight: 600;
        }

        .start-cta {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-top: 18px;
            font-weight: 600;
            color: var(--accent);
        }

        .start-cta i {
            transition: transform 0.3s ease;
        }

        .quiz-card:hover .start-cta i {
            transform: translateX(6px);
        }

        .resume-pill {
            display: inline-block;
            background: rgba(251,191,36,0.16);
            border: 1px solid rgba(251,191,36,0.45);
            color: #fde68a;
            border-radius: 100px;
            padding: 3px 12px;
            font-size: 0.8rem;
            margin-bottom: 12px;
            align-self: flex-start;
        }

        /* Quiz play */

        .quiz-panel {
            padding: 50px;
            max-width: 820px;
            margin: 0 auto;
            position: relative;
            overflow: hidden;
        }

        .quiz-panel::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--accent), #c084fc, #f472b6);
        }

        .quiz-panel:hover,
        .quiz-panel.glass-card:hover {
            transform: none;
        }

        .quiz-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            color: var(--muted);
            font-size: 0.95rem;
        }

        .quiz-top .quiz-name {
            color: white;
            font-weight: 600;
        }

        #quizCounter {
            background: rgba(255,255,255,0.1);
            border-radius: 100px;
            padding: 4px 14px;
            font-weight: 500;
            color: white;
        }

        .progress-track {
            height: 10px;
            border-radius: 100px;
            background: rgba(255,255,255,0.1);
            overflow: hidden;
            margin-bottom: 35px;
        }

        .progress-fill {
            height: 100%;
            width: 0%;
            border-radius: 100px;
            background: linear-gradient(90deg, var(--accent), #c084fc, #f472b6);
            transition: width 0.5s ease;
        }

        .question-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.9rem;
            line-height: 1.35;
            margin-bottom: 30px;
        }

        .option-btn {
            display: flex;
            align-items: center;
            gap: 16px;
            width: 100%;
            text-align: left;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.14);
            color: white;
            border-radius: 18px;
            padding: 16px 20px;
            margin-bottom: 14px;
            font-size: 1.05rem;
            transition: 0.3s ease;
        }

        .option-btn:hover:not(:disabled) {
            background: rgba(255,255,255,0.14);
            border-color: var(--accent);
            transform: translateX(6px);
        }

        .option-btn:hover:not(:disabled) .option-letter {
            background: var(--accent);
            color: #06182e;
        }

        .option-btn:disabled {
            cursor: default;
        }

        .option-letter {
            flex-shrink: 0;
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: rgba(255,255,255,0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.9rem;
            transition: 0.3s ease;
        }

        .option-btn.correct {
            background: rgba(52,211,153,0.16);
            border-color: var(--correct);
        }

        .option-btn.correct .option-letter {
            background: var(--correct);
            color: #04210f;
        }

        .option-btn.wrong {
            background: rgba(251,146,60,0.14);
            border-color: var(--wrong);
        }

        .option-btn.wrong .option-letter {
            background: var(--wrong);
            color: #2a1204;
        }

        .option-btn.selected {
            background: rgba(96,165,250,0.16);
            border-color: var(--primary);
        }

        .option-btn.selected .option-letter {
            background: var(--primary);
            color: #06182e;
        }

        .option-btn.missed {
            border-style: dashed;
        }

        .multi-hint {
            display: none;
            color: #fde68a;
            font-weight: 500;
            font-size: 0.95rem;
            margin: -14px 0 22px;
        }

        /* Feedback panel (appears under the options) */

        .feedback-panel {
            display: none;
            margin: 6px 0 24px;
            padding: 20px 24px;
            border-radius: 18px;
            background: rgba(255,255,255,0.07);
            border: 1px solid var(--border);
            border-left: 4px solid var(--primary);
        }

        .feedback-panel.show {
            display: block;
            animation: fadeUp 0.4s ease;
        }

        .feedback-panel.good {
            background: rgba(52,211,153,0.1);
            border-color: rgba(52,211,153,0.4);
            border-left-color: var(--correct);
        }

        .feedback-panel.bad {
            background: rgba(251,146,60,0.1);
            border-color: rgba(251,146,60,0.4);
            border-left-color: var(--wrong);
        }

        .fb-head {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 6px;
        }

        .fb-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .feedback-panel.good .fb-icon {
            background: var(--correct);
            color: #04210f;
            animation: pop 0.45s ease;
        }

        .feedback-panel.bad .fb-icon {
            background: var(--wrong);
            color: #2a1204;
        }

        @keyframes pop {

            0% { transform: scale(0.4); }
            70% { transform: scale(1.25); }
            100% { transform: scale(1); }

        }

        .fb-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
        }

        .feedback-panel.good .fb-title {
            color: var(--correct);
        }

        .feedback-panel.bad .fb-title {
            color: var(--wrong);
        }

        .fb-answer {
            color: white;
            font-weight: 500;
            line-height: 1.6;
            margin: 4px 0 10px;
        }

        .fb-fact {
            color: var(--muted);
            line-height: 1.7;
            margin-top: 8px;
        }

        .fb-fact-label {
            display: block;
            color: #fbbf24;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .quiz-actions {
            display: flex;
            gap: 14px;
            margin-top: 10px;
        }

        .quiz-actions .btn-ghost {
            width: auto;
            flex-shrink: 0;
        }

        /* Results */

        .score-circle {
            width: 190px;
            height: 190px;
            border-radius: 50%;
            margin: 0 auto 28px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background:
                radial-gradient(closest-side, #0e1c34 78%, transparent 80% 100%),
                conic-gradient(#2dd4bf, #60a5fa, #a78bfa, #f472b6 calc(var(--pct) * 1%), rgba(255,255,255,0.1) 0);
        }

        .score-circle .score-big {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            line-height: 1;
        }

        .score-circle .score-small {
            color: var(--muted);
            font-size: 0.95rem;
            margin-top: 6px;
        }

        .result-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.4rem;
            margin-bottom: 10px;
            text-align: center;
        }

        .result-text {
            color: var(--muted);
            text-align: center;
            line-height: 1.8;
            margin-bottom: 35px;
        }

        .review-list {
            margin-bottom: 35px;
        }

        .review-item {
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 18px;
            padding: 18px 22px;
            margin-bottom: 12px;
        }

        .review-item .review-q {
            font-weight: 600;
            margin-bottom: 8px;
        }

        .review-item .review-a {
            color: var(--muted);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .review-item.is-correct {
            border-left: 3px solid var(--correct);
        }

        .review-item.is-wrong {
            border-left: 3px solid var(--wrong);
        }

        .result-actions {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .result-actions button {
            flex: 1 1 200px;
        }

        .clear-link {
            background: none;
            border: none;
            color: var(--muted);
            font-size: 0.9rem;
            text-decoration: underline;
            margin-top: 30px;
        }

        .clear-link:hover {
            color: white;
        }

        /* Confetti */

        .confetti {
            position: fixed;
            top: -20px;
            width: 10px;
            height: 16px;
            border-radius: 2px;
            z-index: 3000;
            pointer-events: none;
            animation: confettiFall 2.8s ease-in forwards;
        }

        @keyframes confettiFall {

            to {
                transform: translate(var(--x), 105vh) rotate(var(--r));
                opacity: 0.9;
            }

        }

        /* Footer */

        footer {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding: 45px 0;
            text-align: center;
            color: rgba(255,255,255,0.7);
        }

        .socials {
            margin-bottom: 20px;
        }

        .socials a {
            width: 50px;
            height: 50px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin: 0 8px;
            background: rgba(255,255,255,0.08);
            color: white;
            transition: 0.35s ease;
        }

        .socials a:hover {
            background: linear-gradient(135deg, #2563eb, #8b5cf6);
            transform: translateY(-5px);
        }

        /* Animations */

        @keyframes fadeUp {

            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        .reveal {
            opacity: 0;
            transform: translateY(60px);
            transition: all 1s ease;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Responsive */

        @media(max-width: 992px) {

            .hero h1 {
                font-size: 3.5rem;
            }

            .quiz-panel {
                padding: 35px;
            }

        }

        @media(max-width: 768px) {

            .hero {
                min-height: 50vh;
                text-align: center;
            }

            .hero h1 {
                font-size: 2.8rem;
            }

            .quiz-panel {
                padding: 30px 22px;
            }

            .question-text {
                font-size: 1.5rem;
            }

            .result-title {
                font-size: 2rem;
            }

            .float-glyph {
                display: none;
            }

        }

        @media (prefers-reduced-motion: reduce) {

            html {
                scroll-behavior: auto;
            }

            *, *::before, *::after {
                animation: none !important;
                transition-duration: 0.01ms !important;
            }

        }

    </style>

</head>

<body>

    <!-- Animated Background -->
    <div class="bg-blur bg-one"></div>
    <div class="bg-blur bg-two"></div>
    <div class="bg-blur bg-three"></div>
    <div class="bg-blur bg-four"></div>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg fixed-top" id="mainNav">

        <div class="container">

            <a class="navbar-brand" href="/">
                Matthew Thompson • Zenith Tutoring
            </a>

            <button class="navbar-toggler text-white"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarResponsive">

                <i class="fas fa-bars"></i>

            </button>

            <div class="collapse navbar-collapse" id="navbarResponsive">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contact">Contact</a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- Hero -->
    <section class="hero">

        <span class="float-glyph" style="left:8%; top:30%; font-size:5rem; color:#fbbf24;" aria-hidden="true">?</span>
        <span class="float-glyph" style="right:9%; top:24%; font-size:6.5rem; color:#f472b6; animation-delay:-3s;" aria-hidden="true">!</span>
        <span class="float-glyph" style="right:24%; top:66%; font-size:4rem; color:#34d399; animation-delay:-6s;" aria-hidden="true">&#10003;</span>

        <div class="container">

            <div class="row justify-content-center text-center">

                <div class="col-lg-8">

                    <div class="hero-badge">
                        <i class="fas fa-lightbulb"></i>
                        Quick quizzes, big learning
                    </div>

                    <h1>
                        Ready for a <span>quick quiz?</span>
                    </h1>

                    <p>
                        Pick a subject below and see what you know in History, English Literature or English Language.
                        Have a go, learn something new and beat your best score.
                    </p>

                    <div class="hero-chips">
                        <span><i class="fas fa-bolt"></i>Instant feedback</span>
                        <span><i class="fas fa-star"></i>Tracks your best score</span>
