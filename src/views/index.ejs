    <!-- Scroll Animations + navbar behaviour -->
    <script>

        const reveals = document.querySelectorAll(".reveal");
        const navbar = document.getElementById("mainNav");
        const toTop = document.getElementById("toTop");

        function revealOnScroll() {

            reveals.forEach((element) => {

                const windowHeight = window.innerHeight;
                const revealTop = element.getBoundingClientRect().top;

                if (revealTop < windowHeight - 100) {
                    element.classList.add("active");
                }

            });

        }

        function onScroll() {

            revealOnScroll();

            navbar.classList.toggle("scrolled", window.scrollY > 40);
            toTop.classList.toggle("show", window.scrollY > 600);

        }

        window.addEventListener("scroll", onScroll, { passive: true });

        onScroll();

        toTop.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
        });

        // Highlight the nav link for the section currently on screen
        const navLinks = Array.from(document.querySelectorAll('#mainNav .nav-link[href^="#"]'));

        if ("IntersectionObserver" in window) {

            const spy = new IntersectionObserver((entries) => {

                entries.forEach((entry) => {

                    if (entry.isIntersecting) {

                        navLinks.forEach((link) => {
                            link.classList.toggle("active", link.getAttribute("href") === "#" + entry.target.id);
                        });

                    }

                });

            }, { rootMargin: "-45% 0px -50% 0px" });

            document.querySelectorAll("section[id]").forEach((section) => spy.observe(section));

        }

        // Close the mobile menu after tapping an in-page link
        navLinks.forEach((link) => {

            link.addEventListener("click", () => {

                const menu = document.getElementById("navMenu");

                if (menu.classList.contains("show")) {
                    bootstrap.Collapse.getOrCreateInstance(menu).hide();
                }

            });

        });

    </script>

